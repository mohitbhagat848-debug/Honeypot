{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/trap/:path*", "destination": "/api/index.js" },
    { "source": "/trap", "destination": "/api/index.js" },
    { "source": "/assets/:path*", "destination": "/client/assets/:path*" },
    { "source": "/((?!api|trap|assets).*)", "destination": "/client/index.html" }
  ]
}
