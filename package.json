{
  "name": "honeypot-network-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack real-time honeypot network analyzer for defensive security research",
  "scripts": {
    "predev": "kill-port 5000 5173 5174 5175 5176 || exit 0",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "kill-port": "^2.0.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "ua-parser-js": "^1.0.39"
  }
}
