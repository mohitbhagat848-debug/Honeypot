# Copy to project root as `.env` (server loads ../.env from server/)

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/honeypot_analyzer

# API server
PORT=5000

# JWT — use a long random secret in production (16+ characters)
JWT_SECRET=change_this_to_a_long_random_secret_key_min_16_chars

# CORS: comma-separated origins for browser + Socket.io
CLIENT_ORIGIN=http://localhost:5173

# Optional: explicit URLs for the React app (defaults shown)
# VITE_API_URL=
# VITE_SOCKET_URL=http://localhost:5000
# VITE_API_ORIGIN=http://localhost:5000

# Seed script defaults (optional overrides)
# ADMIN_EMAIL=admin@honeypot.local
# ADMIN_PASSWORD=root123
